# ============================================================
# MetaTrader 5 Account Credentials
# ============================================================
MT5_LOGIN=12345678                 # Your MT5 account number
MT5_PASSWORD=your_password_here
MT5_SERVER=MetaQuotes-Demo         # Broker server name (from MT5 File > Open Account)
# Path to terminal64.exe — required on Windows if auto-detect fails
# Windows: C:\\Program Files\\MetaTrader 5\\terminal64.exe
# macOS/Wine: /Users/you/.wine/drive_c/Program Files/MetaTrader 5/terminal64.exe
MT5_PATH=
MT5_TIMEOUT=60000                  # MT5 init timeout (ms)
MT5_PORTABLE=false

# ============================================================
# Live Trading Configuration
# ============================================================
SYMBOLS=EURUSD,GBPUSD              # Symbols the live bot trades (comma-separated)
TIMEFRAME=M15                      # M1, M5, M15, M30, H1, H4, D1
HIGHER_TIMEFRAME=H4                # Used for the HTF trend-bias filter

# Strategy parameters
EMA_FAST=20
EMA_SLOW=50
EMA_TREND=200
ATR_PERIOD=14
ADX_PERIOD=14
ADX_THRESHOLD=22                   # Below this -> ranging market, no trades
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
BB_PERIOD=20
BB_STDDEV=2.0

# ============================================================
# Risk Management
# ============================================================
RISK_PER_TRADE=0.5                 # % of equity risked per trade
MAX_DAILY_LOSS_PCT=3.0             # Halt trading if daily loss exceeds this %
MAX_DRAWDOWN_PCT=10.0              # Halt trading if equity drawdown exceeds this %
MAX_OPEN_POSITIONS=3
MAX_POSITIONS_PER_SYMBOL=1
MAX_TRADES_PER_DAY=10

# SL/TP (ATR multiples)
SL_ATR_MULT=1.5
TP_ATR_MULT=2.5                    # Reward:Risk approximately 1.67
TRAILING_ATR_MULT=1.0
USE_TRAILING_STOP=true
BREAKEVEN_AT_R=1.0                 # Move SL to breakeven after N×R of profit

# Order execution
MAX_SPREAD_POINTS=25               # Skip trade if spread exceeds this
SLIPPAGE_POINTS=10
MAGIC_NUMBER=20260519              # Unique ID — bot only manages its own trades
ORDER_COMMENT=PyBot_v1

# Cooldown after consecutive losses
COOLDOWN_LOSSES=2
COOLDOWN_MINUTES=60

# Lot sizing (also read per-symbol from MT5 when available)
MIN_LOT=0.01
MAX_LOT=5.0
LOT_STEP=0.01

# ============================================================
# Bot Behavior
# ============================================================
POLL_INTERVAL_SECONDS=5
TRADING_HOURS_START=07             # UTC hour to start trading
TRADING_HOURS_END=20               # UTC hour to stop opening new trades
TRADE_ON_WEEKEND=false
DRY_RUN=true                       # true = log decisions only, no real orders sent

# Logging
LOG_LEVEL=INFO                     # DEBUG / INFO / WARNING / ERROR
LOG_DIR=logs
JOURNAL_CSV=logs/trade_journal.csv

# ============================================================
# Notifications (optional)
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
NOTIFY_ON_OPEN=true
NOTIFY_ON_CLOSE=true
NOTIFY_ON_ERROR=true
DAILY_SUMMARY_HOUR=22              # UTC hour for daily P&L summary message

# ============================================================
# ML / Probabilistic filter (optional)
# ============================================================
USE_ML_FILTER=false
ML_MODEL_PATH=models/filter.pkl
ML_MIN_PROBABILITY=0.55

# ============================================================
# Backtesting  (python backtest.py)
# ============================================================
BACKTEST_EQUITY=10000.0            # Simulated starting equity
BACKTEST_BARS=20000                # LTF bars to fetch per symbol (HTF = max(2000, bars/4))
BACKTEST_SPREAD_PIPS=0             # 0 = use each symbol's live broker spread
                                   # >0 = override all symbols with this pip value
BACKTEST_OUTPUT_CSV=backtest_results.csv  # Results file (rows merged on re-run)
BACKTEST_MIN_BARS=500              # Skip symbols with fewer historical bars than this

# ── Symbol selection (first matching rule wins) ─────────────────────────── #
# 1. --symbol CLI arg  (python backtest.py --symbol US500)
# 2. BACKTEST_SYMBOLS list
# 3. BACKTEST_ALL_SYMBOLS=true  ->  auto-discover from MT5 (all instruments)
# 4. BACKTEST_SCAN_ALL=true     ->  built-in 30-symbol forex+metals list
# 5. Live SYMBOLS list above

# Comma-separated override list — skips the auto-discovery below when set
BACKTEST_SYMBOLS=

# true = scan the built-in forex+metals list (7 majors + 22 crosses + XAUUSD/XAGUSD)
BACKTEST_SCAN_ALL=true

# true = pull every visible symbol from the connected MT5 terminal
#        (forex, stock CFDs, futures, indices, crypto — whatever your broker offers)
BACKTEST_ALL_SYMBOLS=false

# ── Filters applied when BACKTEST_ALL_SYMBOLS=true ─────────────────────── #
# Regex matched against symbol names. Leave empty for no filter. Examples:
#   ^(EUR|GBP|USD|JPY|AUD|CAD|NZD|CHF).*   -> forex pairs only
#   ^(US|GER|UK|JP|NAS|SP|HK).*             -> common index prefixes
#   .*\.US$                                  -> broker US stock suffix
BACKTEST_SYMBOL_FILTER=

# Comma-separated MT5 group/path prefixes. Leave empty for no filter. Examples:
#   Forex,Indices,Metals
#   Forex\Majors,CFD\Indices,CFD\Stocks\US   (use \ not /)
BACKTEST_SYMBOL_GROUPS=
