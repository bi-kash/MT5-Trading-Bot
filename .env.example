# ============================================================
# MetaTrader 5 Account Credentials
# ============================================================
MT5_LOGIN=5050691134
MT5_PASSWORD=H_WgFbT7
MT5_SERVER=MetaQuotes-Demo
MT5_PATH=                          # Optional: path to terminal64.exe (Wine on macOS, e.g. /Users/you/.wine/drive_c/Program Files/MetaTrader 5/terminal64.exe)
MT5_TIMEOUT=60000                  # MT5 init timeout (ms)
MT5_PORTABLE=false

# ============================================================
# Trading Configuration
# ============================================================
SYMBOLS=EURUSD,GBPUSD              # Comma-separated list
TIMEFRAME=M15                      # M1, M5, M15, M30, H1, H4, D1
HIGHER_TIMEFRAME=H4                # For multi-timeframe trend filter

# Strategy parameters
EMA_FAST=20
EMA_SLOW=50
EMA_TREND=200
ATR_PERIOD=14
ADX_PERIOD=14
ADX_THRESHOLD=22                   # Below this -> ranging market, no trades
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
BB_PERIOD=20
BB_STDDEV=2.0

# ============================================================
# Risk Management
# ============================================================
RISK_PER_TRADE=0.5                 # % of equity risked per trade
MAX_DAILY_LOSS_PCT=3.0             # Halt trading if daily loss exceeds this %
MAX_DRAWDOWN_PCT=10.0              # Halt trading if equity drawdown exceeds this %
MAX_OPEN_POSITIONS=3
MAX_POSITIONS_PER_SYMBOL=1
MAX_TRADES_PER_DAY=10

# SL/TP (ATR multiples)
SL_ATR_MULT=1.5
TP_ATR_MULT=2.5                    # Reward:Risk approximately 1.67
TRAILING_ATR_MULT=1.0
USE_TRAILING_STOP=true
BREAKEVEN_AT_R=1.0                 # Move SL to breakeven after this many R of profit

# Order execution
MAX_SPREAD_POINTS=25               # Skip trade if spread exceeds this
SLIPPAGE_POINTS=10
MAGIC_NUMBER=20260519
ORDER_COMMENT=PyBot_v1

# Cooldown after consecutive losses
COOLDOWN_LOSSES=2                  # After N consecutive losses
COOLDOWN_MINUTES=60

# Lot sizing
MIN_LOT=0.01
MAX_LOT=5.0
LOT_STEP=0.01                      # Will be overridden by symbol info

# ============================================================
# Bot Behavior
# ============================================================
POLL_INTERVAL_SECONDS=5
TRADING_HOURS_START=07             # UTC hour to start trading
TRADING_HOURS_END=20               # UTC hour to stop opening new trades
TRADE_ON_WEEKEND=false
DRY_RUN=true                       # true = no real orders, just simulate decisions

# Logging
LOG_LEVEL=INFO                     # DEBUG / INFO / WARNING / ERROR
LOG_DIR=logs
JOURNAL_CSV=logs/trade_journal.csv

# ============================================================
# Notifications (optional)
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
NOTIFY_ON_OPEN=true
NOTIFY_ON_CLOSE=true
NOTIFY_ON_ERROR=true
DAILY_SUMMARY_HOUR=22              # UTC hour for daily summary

# ============================================================
# ML / Probabilistic filter (optional)
# ============================================================
USE_ML_FILTER=false
ML_MODEL_PATH=models/filter.pkl
ML_MIN_PROBABILITY=0.55
